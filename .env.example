# ============================================================
# Proveedor de LLM
# ============================================================
# ollama -> Ollama local o cloud
# gemini -> Google Gemini (Google AI Studio)
# El modelo se elige desde la interfaz web.
LLM_PROVIDER=ollama

# ============================================================
# Google Gemini (opcional)
# ============================================================
# Crea tu API key en https://aistudio.google.com/apikey
# No subas esta key al repositorio.
GEMINI_API_KEY=
# Temperatura de generación (0.0 - 2.0). Por defecto 1.0.
GEMINI_TEMPERATURE=1.0
# Incluir el razonamiento interno en la respuesta y mostrarlo en consola.
GEMINI_INCLUDE_THOUGHTS=true
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MAX_OUTPUT_TOKENS=8192

# ============================================================
# Ollama · configuración de conexión
# ============================================================
# LOCAL (por defecto):
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_API_KEY=
#
# CLOUD / API directa:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=tu_api_key_de_ollama
#
# Importante: el sufijo "-cloud" solo funciona con Ollama local.
# Si usas la API directa de Ollama Cloud, escribe el modelo SIN "-cloud".
# La API key es opcional; si está vacía, se usa Ollama local sin autenticación.
#
# Opcional: modelo de respaldo si /api/tags no devuelve el catálogo
# (por ejemplo, en Ollama Cloud). Normalmente no necesitas definirlo.
# OLLAMA_MODEL=gemma4:31b-cloud
# ============================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0.4
OLLAMA_NUM_CTX=12000
